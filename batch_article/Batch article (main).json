    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS batchs (\n  id BIGSERIAL PRIMARY KEY,\n  file_name VARCHAR(255) NOT NULL,\n  prompt_template TEXT NOT NULL,\n  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE TABLE IF NOT EXISTS tasks (\n  id BIGSERIAL PRIMARY KEY,\n  batch_id BIGINT NOT NULL REFERENCES batchs(id) ON DELETE CASCADE,\n  row_index INTEGER NOT NULL,\n  theme VARCHAR(500) NOT NULL,\n  status VARCHAR(20) NOT NULL DEFAULT 'QUEUED',\n  error_message TEXT,\n  retry_count INTEGER NOT NULL DEFAULT 0,\n  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  CONSTRAINT tasks_status_check CHECK (status IN ('QUEUED', 'SUCCESS', 'ERROR'))\n);\n\nCREATE TABLE IF NOT EXISTS responses (\n  id BIGSERIAL PRIMARY KEY,\n  task_id BIGINT NOT NULL UNIQUE REFERENCES tasks(id) ON DELETE CASCADE,\n  content TEXT NOT NULL,\n  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nCREATE INDEX IF NOT EXISTS idx_tasks_batch_id ON tasks(batch_id);\nCREATE INDEX IF NOT EXISTS idx_tasks_status ON tasks(status);\n\nALTER TABLE tasks ADD COLUMN IF NOT EXISTS retry_count INTEGER NOT NULL DEFAULT 0;",
        "options": {}
      },
