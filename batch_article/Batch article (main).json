    {
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const binary = item.binary ?? {};\n  const word = binary.Prompt_Template;\n  if (!word) return item;\n\n  const originalName = word.fileName ?? 'prompt.docx';\n  const zipName = originalName.replace(/\\.docx$/i, '') + '.zip';\n\n  return {\n    json: { ...item.json, word_file_name: originalName },\n    binary: {\n      ...binary,\n      Prompt_Template: {\n        ...word,\n        fileName: zipName,\n        fileExtension: 'zip',\n        mimeType: 'application/zip',\n      },\n    },\n  };\n});"
      },
