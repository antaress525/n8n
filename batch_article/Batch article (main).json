      "id": "91682cd1-c84e-4103-8df1-3adb18059138",
      "name": "Extract Excel Tasks",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        256,
        -256
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst templateItem = items.find((item) => typeof item.json.prompt_template === 'string' && item.json.prompt_template.length > 0);\nif (!templateItem) throw new Error('Prompt template extraction failed.');\n\nconst template = templateItem.json.prompt_template;\nconst fileName = templateItem.json.file_name ?? 'prompt.docx';\nconst themeKeyPattern = /theme|thème|sujet|topic|tache|tâche|task/i;\nconst rows = items.filter((item) => item !== templateItem);\n\nconst tasks = [];\nfor (const [index, item] of rows.entries()) {\n  const data = item.json ?? {};\n  const keys = Object.keys(data);\n  const themeKey =\n    keys.find((key) => themeKeyPattern.test(key)) ??\n    keys.find((key) => typeof data[key] === 'string' && data[key].trim().length > 0);\n  const theme = themeKey ? String(data[themeKey] ?? '').trim() : '';\n  if (!theme) continue;\n  tasks.push({ row_index: index + 2, theme });\n}\n\nif (tasks.length === 0) throw new Error('No task found in the Excel file. Check that the first sheet contains a theme column.');\nreturn [{ json: { file_name: fileName, prompt_template: template, tasks } }];"
      },
      "id": "01a0974b-680a-422b-b420-ffc0ae11011e",
      "name": "Build Batch Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        80
      ]
