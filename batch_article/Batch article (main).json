      "id": "11248dd8-9193-4307-9906-3ca4ded225c9",
      "name": "Decompress Word",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1.1,
      "position": [
        256,
        -528
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaryKeys = Object.keys(item.binary ?? {});\nif (binaryKeys.length === 0) throw new Error('No decompressed file found in the Word upload.');\n\nlet template = null;\nconst fileName = item.json.word_file_name ?? 'prompt.docx';\n\nfor (const key of binaryKeys) {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, key);\n  const xml = buffer.toString('utf8');\n  if (!xml.includes('<w:document')) continue;\n\n  const body = xml.match(/<w:body>([\\s\\S]*)<\\/w:body>/)?.[1] ?? xml;\n  const withBreaks = body\n    .replace(/<w:tab[^>]*\\/>/g, '\\t')\n    .replace(/<w:br[^>]*\\/>/g, '\\n')\n    .replace(/<\\/w:p>/g, '\\n');\n  const plain = withBreaks.replace(/<[^>]+>/g, '');\n  const decoded = plain\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, String.fromCharCode(34))\n    .replace(/&apos;/g, String.fromCharCode(39))\n    .replace(/&amp;/g, '&');\n\n  template = decoded.replace(/\\n{3,}/g, '\\n\\n').trim();\n  break;\n}\n\nif (!template) throw new Error('word/document.xml was not found in the uploaded .docx file.');\nreturn [{ json: { prompt_template: template, file_name: fileName } }];"
      },
      "id": "68e83ef6-2319-4c36-920b-381dccee41d1",
      "name": "Extract Word Text",
