    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH reset AS (\n  UPDATE tasks\n  SET status = 'QUEUED', error_message = NULL, updated_at = now()\n  WHERE batch_id = $1::bigint\n    AND status IN ('ERROR', 'QUEUED')\n  RETURNING id, batch_id, theme, retry_count, row_index\n)\nSELECT r.id, r.theme, r.retry_count, b.prompt_template\nFROM reset r\nJOIN batchs b ON b.id = r.batch_id\nORDER BY r.row_index;",
        "options": {
          "queryReplacement": "={{ $json.batch_id }}"
        }
      },
